# Copy outside the website root to /etc/trainpal/production.env (0600).
APP_ENV=production
DEPLOYMENT_PROFILE=portfolio
ANALYSIS_PROVIDER=cloud
PUBLIC_BASE_PATH=/trainpal
ARK_MODEL_ID=doubao-seed-2-1-pro-260915
ARK_VISUAL_MODEL_ID=doubao-seed-2-1-pro-260628
ARK_ANALYSIS_RESPONSE_FORMAT=json_object
ARK_API_KEY=
VOLC_ASR_API_KEY=
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
GYMTI_LLM_ENABLED=true
GYMTI_LLM_RETENTION_CONFIRMED=true
GYMTI_LLM_MODEL=doubao-seed-2-0-mini-260428
GYMTI_LLM_API_KEY=
GYMTI_LLM_MAX_ATTEMPTS=1
GYMTI_LLM_CONCURRENCY=3
TRAINING_REMINDERS_ENABLED=true
LOCAL_UPLOAD_ENABLED=true
LOCAL_ANALYSIS_MAX_SECONDS=300
LOCAL_UPLOAD_MAX_BYTES=67108864
RUN_TIMEOUT_SECONDS=600
ANALYSIS_EVIDENCE_TIMEOUT_SECONDS=590
ANALYSIS_CHUNK_TIMEOUT_SECONDS=90
ANALYSIS_VISUAL_CHUNK_SECONDS=60
ANALYSIS_VISUAL_OVERLAP_SECONDS=10
ANALYSIS_VISUAL_SHORT_CONTEXT_SECONDS=90
PUBLIC_ANALYSIS_CONCURRENCY=1
JUDGE_ANALYSIS_CONCURRENCY=0
TRUSTED_PROXY_CIDRS=127.0.0.1/32
CORS_ORIGINS=
ACCESS_COOKIE_SECRET=
JUDGE_ACCESS_CODE=
AI_BUDGET_DB_PATH=/var/lib/trainpal/budget/ai.sqlite
SOURCE_MEDIA_ROOT=/var/lib/trainpal/media
PUBLIC_MEDIA_BASE_URL=https://caohonglin.fun/trainpal/media/
