{
  "name": "hachimi-fitness",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm --filter @hachimi/web dev",
    "dev:api": "uv run --project services/analysis-api python -m hakimi_analysis.dev",
    "lint": "pnpm --filter @hachimi/web lint && uv run --project services/analysis-api ruff check services/analysis-api",
    "typecheck": "pnpm --filter @hachimi/web typecheck && uv run --project services/analysis-api mypy --config-file services/analysis-api/pyproject.toml services/analysis-api/src services/analysis-api/tests",
    "test": "pnpm test:web && pnpm test:api",
    "test:web": "pnpm --filter @hachimi/web test:run",
    "test:api": "uv run --project services/analysis-api pytest services/analysis-api/tests",
    "test:e2e": "pnpm e2e:prepare && pnpm --filter @hachimi/web test:e2e",
    "e2e:prepare": "uv run --project services/analysis-api python services/analysis-api/scripts/create_synthetic_video.py",
    "smoke:cloud": "uv run --project services/analysis-api python -m hakimi_analysis.cloud_smoke",
    "media:sync": "uv run --project services/analysis-api python -m hakimi_analysis.sync_media",
    "build": "pnpm --filter @hachimi/web build",
    "api:export": "uv run --project services/analysis-api python services/analysis-api/scripts/export_openapi.py",
    "api:generate": "pnpm api:export && pnpm --filter @hachimi/web api:generate",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
