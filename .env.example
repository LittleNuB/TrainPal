APP_ENV=development
ANALYSIS_PROVIDER=cloud
ARK_API_KEY=
ARK_MODEL_ID=doubao-seed-2-0-mini-260428
ARK_VISUAL_MODEL_ID=doubao-seed-2-0-mini-260428
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLC_ASR_API_KEY=
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
HAKIMI_DEMO_VIDEO_PATH=
SOURCE_MANIFEST_PATH=
SOURCE_MEDIA_ROOT=
PUBLIC_MEDIA_BASE_URL=
IMAGEIO_FFMPEG_EXE=
FFMPEG_BUILD_RECEIPT_PATH=
FFMPEG_EXPECTED_SHA256=
FFMPEG_EXPECTED_CONFIGURATION_SHA256=
SMOKE_ANNOTATIONS_PATH=
JUDGE_ACCESS_CODE=
ACCESS_COOKIE_SECRET=
JUDGE_ANALYSIS_CONCURRENCY=0
PUBLIC_ANALYSIS_CONCURRENCY=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_PROXY_CIDRS=
RUN_TTL_SECONDS=600
RUN_TIMEOUT_SECONDS=180
LOCAL_UPLOAD_ENABLED=true
LOCAL_ANALYSIS_MAX_SECONDS=300
LOCAL_UPLOAD_MAX_BYTES=268435456
ANALYSIS_EVIDENCE_TIMEOUT_SECONDS=170
ANALYSIS_CHUNK_TIMEOUT_SECONDS=20
# pnpm dev:api uses loopback-only local budgets: chunk 90s, evidence 590s, run 600s.
# Set process environment variables to override these local launcher defaults.
# Production entrypoint and the values above remain unchanged.
ANALYSIS_VISUAL_CHUNK_SECONDS=60
ANALYSIS_VISUAL_OVERLAP_SECONDS=10
ANALYSIS_LATENCY_TARGET_MAX_SECONDS_PER_VIDEO_MINUTE=15
GYMTI_LLM_ENABLED=false
GYMTI_LLM_RETENTION_CONFIRMED=false
GYMTI_LLM_API_KEY=
GYMTI_LLM_MODEL=doubao-seed-2-0-mini-260428
GYMTI_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
GYMTI_LLM_TIMEOUT_SECONDS=4
GYMTI_LLM_MAX_ATTEMPTS=2
